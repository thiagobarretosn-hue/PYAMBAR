<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paleta de Parâmetros"
        Width="520"
        SizeToContent="Height"
        MinHeight="300"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">

    <Window.Resources>
        <!-- Cada opção é um bloco clicável inteiro, não só o radio -->
        <Style x:Key="OpcaoStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="6,0,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>
        <Style x:Key="TituloOpcao" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#212121"/>
        </Style>
        <Style x:Key="ResumoOpcao" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#1976D2"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="NotaOpcao" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#757575"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="txt_titulo"
                       Text="Este projeto ainda não tem paleta de parâmetros."
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#1976D2"
                       TextWrapping="Wrap"/>
            <TextBlock Text="Escolha a base de parâmetros para começar:"
                       FontSize="12"
                       Foreground="#616161"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Opções -->
        <StackPanel x:Name="painel_opcoes" Grid.Row="1"/>

        <!-- Aviso quando falta alguma base -->
        <Border x:Name="borda_aviso"
                Grid.Row="2"
                Background="#FFF8E1"
                BorderBrush="#FFB300"
                BorderThickness="1"
                CornerRadius="3"
                Padding="8,6"
                Margin="0,4,0,0"
                Visibility="Collapsed">
            <TextBlock x:Name="txt_aviso"
                       FontSize="11"
                       Foreground="#795548"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Ações -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="btn_usar"
                    Content="Usar"
                    Width="110"
                    Height="32"
                    Margin="0,0,8,0"
                    Background="#1976D2"
                    Foreground="White"
                    FontSize="13"
                    FontWeight="SemiBold"/>
            <Button x:Name="btn_cancelar"
                    Content="Cancelar"
                    Width="90"
                    Height="32"
                    FontSize="13"/>
        </StackPanel>
    </Grid>
</Window>
