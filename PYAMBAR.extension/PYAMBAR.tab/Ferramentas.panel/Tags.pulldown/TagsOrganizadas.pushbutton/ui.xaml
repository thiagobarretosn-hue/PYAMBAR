<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tags Organizadas"
        Height="780" Width="1240" MinHeight="600" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Background="#F4F6F9"
        FontFamily="Segoe UI" FontSize="12"
        Foreground="#1F2933"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <!-- Layout: cabecalho com a vista e o template; corpo em duas colunas
         (o que etiquetar | como arrumar); rodape com o resumo e a acao.
         Paleta e botoes iguais ao Fluxo ARN v3 (padrao do lab). As linhas de
         categoria sao montadas no janela.py com os estilos daqui
         (FindResource: Interruptor, Marca, Linha, Selo*). -->
    <Window.Resources>
        <!-- ====================================================== paleta -->
        <SolidColorBrush x:Key="Texto" Color="#1F2933"/>
        <SolidColorBrush x:Key="Texto2" Color="#5B6675"/>
        <!-- #6B7685: 4,6:1 sobre branco (o #8A94A3 de antes dava 3,1:1) -->
        <SolidColorBrush x:Key="Texto3" Color="#6B7685"/>
        <SolidColorBrush x:Key="Borda" Color="#E3E7ED"/>
        <SolidColorBrush x:Key="BordaForte" Color="#C9D1DB"/>
        <SolidColorBrush x:Key="Fundo" Color="#F4F6F9"/>
        <SolidColorBrush x:Key="FundoHover" Color="#F7F9FC"/>
        <SolidColorBrush x:Key="Acento" Color="#2969B0"/>
        <SolidColorBrush x:Key="AcentoEscuro" Color="#1F5A99"/>
        <SolidColorBrush x:Key="AcentoClaro" Color="#EAF2FB"/>
        <SolidColorBrush x:Key="Alerta" Color="#B54708"/>
        <SolidColorBrush x:Key="AlertaClaro" Color="#FEF4E6"/>
        <SolidColorBrush x:Key="Perigo" Color="#B42318"/>
        <SolidColorBrush x:Key="PerigoClaro" Color="#FDECEA"/>
        <FontFamily x:Key="Icones">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- ================================================= tipografia -->
        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Texto3}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TituloCartao" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        </Style>
        <Style x:Key="Nota" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Texto2}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Icone" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icones}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Cartao" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>

        <!-- linha de categoria (janela.py): realce ao passar o mouse -->
        <Style x:Key="Linha" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="6,10,6,10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource FundoHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- selos (contagem da categoria) -->
        <Style x:Key="SeloAzul" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AcentoClaro}"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="8,1,8,2"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SeloCinza" TargetType="Border" BasedOn="{StaticResource SeloAzul}">
            <Setter Property="Background" Value="#EEF1F5"/>
        </Style>
        <Style x:Key="SeloAlerta" TargetType="Border" BasedOn="{StaticResource SeloAzul}">
            <Setter Property="Background" Value="{StaticResource AlertaClaro}"/>
        </Style>

        <!-- ==================================================== botoes -->
        <Style TargetType="Button" x:Key="PassoBtn">
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordaForte}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo" Property="Background" Value="#EEF3FA"/>
                                <Setter TargetName="Fundo" Property="BorderBrush" Value="#9DB6D6"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Fundo" Property="BorderBrush" Value="{StaticResource Acento}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fundo" Property="Background" Value="#DCE7F5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="PrimarioBtn" BasedOn="{StaticResource PassoBtn}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Acento}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Acento}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo" Property="Background" Value="{StaticResource AcentoEscuro}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Fundo" Property="BorderBrush" Value="#0F3B66"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fundo" Property="Background" Value="#174A80"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================================================== controles -->
        <!-- interruptor liga/desliga (categoria) -->
        <Style x:Key="Interruptor" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="36" Height="20" Background="Transparent">
                            <Border x:Name="Trilho" CornerRadius="10" Background="#C9D1DB"
                                    BorderBrush="Transparent" BorderThickness="1.5"/>
                            <Ellipse x:Name="Bola" Width="14" Height="14" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Trilho" Property="Background" Value="{StaticResource Acento}"/>
                                <Setter TargetName="Bola" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Bola" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Trilho" Property="BorderBrush" Value="#0F3B66"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- caixinha arredondada com texto ao lado (angulos, refazer, unir) -->
        <Style x:Key="Marca" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Caixa" Width="18" Height="18" CornerRadius="4"
                                    Background="White" BorderBrush="{StaticResource BordaForte}"
                                    BorderThickness="1.5" VerticalAlignment="Center">
                                <TextBlock x:Name="Visto" Text="&#xE73E;" FontFamily="{StaticResource Icones}"
                                           FontSize="11" Foreground="White" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter x:Name="Conteudo" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Caixa" Property="Background" Value="{StaticResource Acento}"/>
                                <Setter TargetName="Caixa" Property="BorderBrush" Value="{StaticResource Acento}"/>
                                <Setter TargetName="Visto" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter TargetName="Conteudo" Property="Margin" Value="0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Caixa" Property="BorderBrush" Value="#9DB6D6"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Caixa" Property="BorderBrush" Value="#0F3B66"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- cartao de escolha do estilo (Perto / Margem) -->
        <Style x:Key="OpcaoCartao" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Moldura" CornerRadius="8" Background="White"
                                BorderBrush="{StaticResource Borda}" BorderThickness="1.5" Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Moldura" Property="BorderBrush" Value="#9DB6D6"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Moldura" Property="BorderBrush" Value="{StaticResource Acento}"/>
                                <Setter TargetName="Moldura" Property="Background" Value="{StaticResource AcentoClaro}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Moldura" Property="BorderBrush" Value="#0F3B66"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- botao segmentado (Completo | Rapido) -->
        <Style x:Key="Segmento" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Texto2}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Fundo" CornerRadius="5" Background="Transparent" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo" Property="Background" Value="#E9EEF5"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Fundo" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource Acento}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <!-- o combo fechado corta 'Familia : Tipo' longo: o nome inteiro na dica -->
            <Setter Property="ToolTip" Value="{Binding SelectedItem, RelativeSource={RelativeSource Self}}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordaForte}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Moldura" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <!-- sem Margin: o TextBox ja repassa o Padding ao ScrollViewer -->
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Moldura" Property="BorderBrush" Value="#9DB6D6"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Moldura" Property="BorderBrush" Value="{StaticResource Acento}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================================================= cabecalho -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Borda}" BorderThickness="0,0,0,1"
                Padding="22,14,22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AcentoClaro}"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE8EC;" Style="{StaticResource Icone}" FontSize="20"
                               Foreground="{StaticResource Acento}" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Tags Organizadas" FontSize="18" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="&#xE890;" Style="{StaticResource Icone}" FontSize="12"
                                   Foreground="{StaticResource Texto3}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="txt_vista" Style="{StaticResource Nota}" Text="Vista"
                                   VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="TEMPLATE" Style="{StaticResource Rotulo}" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="cmb_template" Width="250"
                                  ToolTip="Padrão fixo por tipo de projeto. Escolher preenche a janela inteira; ajuste e grave com 'Salvar como'."/>
                        <Button x:Name="btn_salvar_template" Style="{StaticResource PassoBtn}" Margin="8,0,0,0"
                                Click="salvar_template_click" MinHeight="30" Padding="10,4"
                                ToolTip="Grava as escolhas desta janela como template (em APPDATA). Mesmo nome = substitui.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" Style="{StaticResource Icone}" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="Salvar como..." VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="txt_nota_template" Style="{StaticResource Nota}" Foreground="{StaticResource Alerta}"
                               Margin="0,4,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================================================== corpo -->
        <Grid Grid.Row="1" Margin="22,16,22,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="col_lista" Width="*" MinWidth="680"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- o que etiquetar -->
            <Border Grid.Column="0" Style="{StaticResource Cartao}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="O que etiquetar" Style="{StaticResource TituloCartao}"/>
                        <TextBlock Style="{StaticResource Nota}" Margin="0,2,0,0"
                                   Text="Ligue as categorias. A contagem é do que ainda não tem tag nesta vista."/>
                    </StackPanel>
                    <!-- cabecalho da tabela: MESMAS larguras das linhas (janela.COLUNAS);
                         a margem direita desconta a barra de rolagem (janela.py) -->
                    <Grid x:Name="grd_cabecalho" Grid.Row="1" Margin="6,0,23,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="72"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="CATEGORIA" Style="{StaticResource Rotulo}"/>
                        <TextBlock Grid.Column="2" Text="TIPO DE TAG" Style="{StaticResource Rotulo}" Margin="8,0,0,0"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0" Background="Transparent"
                                    ToolTip="A ponta de seta é gravada no TIPO de tag: muda TODAS as tags desse tipo no projeto, em todas as vistas (igual à edição manual do tipo). 'Manter' não mexe em nada.">
                            <TextBlock Text="PONTA DE SETA" Style="{StaticResource Rotulo}"/>
                            <TextBlock Text="&#xE946;" Style="{StaticResource Icone}" FontSize="11"
                                       Foreground="{StaticResource Texto3}" Margin="5,0,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="4" Text="UNIR" Style="{StaticResource Rotulo}" HorizontalAlignment="Center"
                                   ToolTip="Pontuais: uma tag só para vizinhos de texto 100% igual. Conduítes: uma tag por feixe de paralelos."/>
                        <TextBlock x:Name="txt_col_x" Grid.Column="5" Text="A CADA (FT)" Style="{StaticResource Rotulo}"
                                   Margin="8,0,0,0"/>
                    </Grid>
                    <!-- barra sempre visivel: com Auto, ao aparecer ela deslocava as
                         linhas 17 px em relacao ao cabecalho -->
                    <ScrollViewer x:Name="sv_categorias" Grid.Row="2" VerticalScrollBarVisibility="Visible">
                        <StackPanel x:Name="pnl_categorias"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- como arrumar -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Cartao}">
                        <StackPanel>
                            <TextBlock Text="Como arrumar" Style="{StaticResource TituloCartao}"/>
                            <TextBlock Style="{StaticResource Nota}" Margin="0,2,0,10"
                                       Text="O estilo sai do tipo de vista; troque se precisar."/>

                            <RadioButton x:Name="rb_perto" GroupName="estilo" Style="{StaticResource OpcaoCartao}"
                                         ToolTip="Tag junto do elemento, chamada a 45 ou 90 graus. Para plantas de slab passes.">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- esboco: elemento, chamada curta, texto ao lado -->
                                    <Canvas Width="46" Height="36" VerticalAlignment="Center">
                                        <Rectangle Canvas.Left="1" Canvas.Top="1" Width="44" Height="34" RadiusX="4" RadiusY="4"
                                                   Fill="#F4F6F9" Stroke="{StaticResource Borda}"/>
                                        <Ellipse Canvas.Left="9" Canvas.Top="22" Width="7" Height="7" Fill="{StaticResource Acento}"/>
                                        <Polyline Points="12.5,25.5 20,14 26,14" Stroke="{StaticResource Texto2}" StrokeThickness="1.2"/>
                                        <Rectangle Canvas.Left="26" Canvas.Top="9" Width="15" Height="10" RadiusX="1.5" RadiusY="1.5"
                                                   Fill="White" Stroke="{StaticResource Texto2}" StrokeThickness="1"/>
                                    </Canvas>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Perto do elemento" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource Nota}" Text="Plantas, slab passes"/>
                                    </StackPanel>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="rb_margem" GroupName="estilo" Style="{StaticResource OpcaoCartao}" Margin="0,8,0,0"
                                         ToolTip="Texto fora do desenho, em coluna de cada lado; água quente à esquerda e fria à direita. Para cortes e installation plans.">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- esboco: desenho tracejado, chamadas saindo para as colunas -->
                                    <Canvas Width="46" Height="36" VerticalAlignment="Center">
                                        <Rectangle Canvas.Left="12" Canvas.Top="2" Width="22" Height="32"
                                                   Fill="#F4F6F9" Stroke="{StaticResource BordaForte}" StrokeDashArray="2 2"/>
                                        <Ellipse Canvas.Left="18" Canvas.Top="20" Width="6" Height="6" Fill="#C2410C"/>
                                        <Polyline Points="21,23 21,12 8,12" Stroke="{StaticResource Texto2}" StrokeThickness="1.2"/>
                                        <Rectangle Canvas.Left="0" Canvas.Top="8" Width="9" Height="8" RadiusX="1" RadiusY="1"
                                                   Fill="White" Stroke="{StaticResource Texto2}" StrokeThickness="1"/>
                                        <Ellipse Canvas.Left="26" Canvas.Top="8" Width="6" Height="6" Fill="{StaticResource Acento}"/>
                                        <Line X1="29" Y1="11" X2="38" Y2="11" Stroke="{StaticResource Texto2}" StrokeThickness="1.2"/>
                                        <Rectangle Canvas.Left="37" Canvas.Top="7" Width="9" Height="8" RadiusX="1" RadiusY="1"
                                                   Fill="White" Stroke="{StaticResource Texto2}" StrokeThickness="1"/>
                                    </Canvas>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Margem" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource Nota}" Text="Cortes, installation plans"/>
                                    </StackPanel>
                                </Grid>
                            </RadioButton>

                            <TextBlock x:Name="txt_nota_arranjo" Style="{StaticResource Nota}" Margin="2,10,0,0"
                                       Text="Ombro sempre horizontal."/>

                            <!-- angulos: so no estilo Perto -->
                            <StackPanel x:Name="pnl_angulos" Margin="0,12,0,0">
                                <TextBlock Text="ÂNGULOS DA CHAMADA" Style="{StaticResource Rotulo}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="chk_a90" Content="90°" IsChecked="True" IsEnabled="False"
                                              Style="{StaticResource Marca}" Margin="0,0,16,0"
                                              ToolTipService.ShowOnDisabled="True"
                                              ToolTip="Sempre ligado: é o recurso quando a diagonal não cabe."/>
                                    <CheckBox x:Name="chk_a45" Content="45°" IsChecked="True"
                                              Style="{StaticResource Marca}" Margin="0,0,16,0"/>
                                    <CheckBox x:Name="chk_a60" Content="60°" Style="{StaticResource Marca}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- busca: so no estilo Margem -->
                            <StackPanel x:Name="pnl_modo" Margin="0,12,0,0">
                                <TextBlock Text="BUSCA" Style="{StaticResource Rotulo}" Margin="0,0,0,6"/>
                                <Border Background="#EEF1F5" CornerRadius="7" Padding="3" HorizontalAlignment="Left"
                                        ToolTip="Completo: tenta 6 ordens de colocação e fica a melhor (o padrão calibrado no F10). Rápido: uma ordem só — bem mais rápido, pode deixar algum cruzamento a mais para ajustar à mão.">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="rb_completo" GroupName="modo" Content="Completo"
                                                     Style="{StaticResource Segmento}" IsChecked="True"/>
                                        <RadioButton x:Name="rb_rapido" GroupName="modo" Content="Rápido"
                                                     Style="{StaticResource Segmento}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="TAGS UNIDAS" Style="{StaticResource Rotulo}" Margin="0,14,0,6"/>
                            <ComboBox x:Name="cmb_estilo"
                                      ToolTip="Ramificações: cada elemento com a sua perna até o ombro comum. Leque: todas as pernas num cotovelo só."/>
                        </StackPanel>
                    </Border>

                    <!-- refazer: destaque de perigo -->
                    <Border Background="{StaticResource PerigoClaro}" CornerRadius="10" Padding="14,12" Margin="0,12,0,0"
                            BorderBrush="#F6C9C4" BorderThickness="1">
                        <StackPanel>
                            <CheckBox x:Name="chk_refazer" Style="{StaticResource Marca}" IsChecked="False"
                                      Foreground="{StaticResource Perigo}" FontWeight="SemiBold"
                                      Content="Refazer as tags que já existem"
                                      ToolTip="Apaga e cria de novo SÓ as tags dos elementos que o botão vai etiquetar (tag manual em elemento que ele não etiqueta fica). Um Ctrl+Z desfaz tudo."/>
                            <TextBlock Style="{StaticResource Nota}" Margin="26,4,0,0"
                                       Text="Ajustes manuais nessas tags se perdem. Um Ctrl+Z desfaz tudo."/>
                        </StackPanel>
                    </Border>

                    <!-- ajuste fino -->
                    <Border Style="{StaticResource Cartao}" Margin="0,12,0,0" Padding="14,10">
                        <Expander x:Name="exp_ajuste" IsExpanded="False">
                            <Expander.Header>
                                <TextBlock x:Name="txt_rot_espaco" Text="AJUSTE FINO (MM NO PAPEL)" Style="{StaticResource Rotulo}"/>
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource Nota}" Margin="0,0,0,8"
                                           Text="Os templates já trazem valores medidos nos projetos. Mexa só se o resultado pedir."/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="72"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="txt_lbl_alcance" Grid.Row="0" Text="Distância máxima ao elemento"
                                               VerticalAlignment="Center" TextWrapping="Wrap"
                                               ToolTip="Até onde a tag pode se afastar do elemento (estilo Perto). No estilo Margem a coluna fica fora do desenho e este valor não é usado."/>
                                    <TextBox x:Name="txt_alcance" Grid.Row="0" Grid.Column="1" Text="22" Margin="0,0,0,6"
                                             ToolTipService.ShowOnDisabled="True"
                                             ToolTip="No estilo Margem a coluna fica fora do desenho e este valor não é usado."/>
                                    <TextBlock Grid.Row="1" Text="Folga mínima entre tags" VerticalAlignment="Center"
                                               ToolTip="Espaço livre em volta do texto de cada tag."/>
                                    <TextBox x:Name="txt_folga" Grid.Row="1" Grid.Column="1" Text="0.8" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="2" Text="Raio para unir tags iguais" VerticalAlignment="Center"
                                               ToolTip="Dois elementos de texto 100% igual mais perto que isto viram UMA tag com várias chamadas (coluna Unir)."/>
                                    <TextBox x:Name="txt_raio" Grid.Row="2" Grid.Column="1" Text="8" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="3" Text="Máx. elementos por tag unida" VerticalAlignment="Center"
                                               ToolTip="Teto. O grupo é dividido primeiro no maior vão entre elementos; sem vão, ao meio."/>
                                    <TextBox x:Name="txt_max_uniao" Grid.Row="3" Grid.Column="1" Text="12" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="4" Text="Máx. conduítes por pente" VerticalAlignment="Center"
                                               ToolTip="Pente maior vira dois, cortados no vão entre feixes, um saindo por cada ponta."/>
                                    <TextBox x:Name="txt_max_pente" Grid.Row="4" Grid.Column="1" Text="8"/>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===================================================== rodape -->
        <Border Grid.Row="2" Margin="22,14,22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE946;" Style="{StaticResource Icone}" Foreground="{StaticResource Acento}"
                           Margin="0,0,8,0"/>
                <TextBlock x:Name="txt_resumo" Grid.Column="1" Style="{StaticResource Nota}" FontSize="12"
                           VerticalAlignment="Center" Text=""/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0">
                    <Button x:Name="btn_cancelar" Content="Cancelar" Style="{StaticResource PassoBtn}"
                            Click="cancelar_click" IsCancel="True"/>
                    <Button x:Name="btn_ok" Style="{StaticResource PrimarioBtn}" Margin="10,0,0,0"
                            Click="ok_click" IsDefault="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8EC;" Style="{StaticResource Icone}" Foreground="White"
                                       FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Etiquetar e organizar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
