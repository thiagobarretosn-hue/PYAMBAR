<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Slab Passes v6.1 - Ressincronizar passes"
        Height="640" Width="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Ressincronizar passes com os tubos"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- O QUE FOI ENCONTRADO -->
        <Border Grid.Row="1" Background="#E3F2FD" BorderBrush="#2196F3" BorderThickness="1"
                CornerRadius="4" Padding="10" Margin="0,0,0,12">
            <TextBlock x:Name="txt_summary" TextWrapping="Wrap" FontSize="12"/>
        </Border>

        <!-- ACOES -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Ações:" FontWeight="Bold" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <CheckBox x:Name="chk_move" Content="Recentralizar pela referência:" IsChecked="True"
                          VerticalAlignment="Center"
                          ToolTip="Eixo do tubo, ou o passe do nível vizinho (cada passe de referência atende um só)"/>
                <ComboBox x:Name="combo_move_ref" Width="270" Height="26" Margin="8,0,0,0"/>
                <TextBlock Text="Puxar até:" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <TextBox x:Name="txt_pull" Width="44" Height="24" VerticalContentAlignment="Center"
                         ToolTip="Só move o passe se a referência estiver dentro deste raio (pol)"/>
                <TextBlock Text="pol" VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
            <CheckBox x:Name="chk_size" Content="Bitola pelo papel (riser +1, aranha +2, mínimo WPS-1 1/2)"
                     IsChecked="True" Margin="0,0,0,4"
                     ToolTip="Troca o tipo WPS do passe; passes de outra família ficam como estão"/>
            <CheckBox x:Name="chk_family" Content="Trocar Watts WPS pelo Concrete Sleeve (mesmo tipo)"
                     IsChecked="True" Margin="0,0,0,4"
                     ToolTip="Passes da familia antiga passam para a familia nova, mesmo nome de tipo"/>
            <CheckBox x:Name="chk_slab" Content="Qtt e altura pela laje (fundo da pilha no fundo da laje)"
                     IsChecked="True" Margin="0,0,0,4"
                     ToolTip="Laje do vinculo sob o passe: Qtt = o menor que cobre a espessura"/>
            <CheckBox x:Name="chk_comments" Content="Comments (para que serve o passe)" IsChecked="True"
                     Margin="0,0,0,4"/>
            <CheckBox x:Name="chk_params" Content="Parâmetros de texto do tubo + Floor pelo nível" IsChecked="True"/>
        </StackPanel>

        <!-- OPCOES DE COMMENTS -->
        <Grid Grid.Row="3" Margin="20,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Riser +" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="combo_riser_source" Grid.Column="1" Height="28" IsEditable="True"
                     ToolTip="Parâmetro do tubo que completa 'Riser ...' — ou digite um texto livre"/>
            <TextBlock Grid.Column="2" Text="P-Trap:" VerticalAlignment="Center" Margin="12,0,6,0"
                       ToolTip="Subida da aranha com P-Trap no pé"/>
            <ComboBox x:Name="combo_tub" Grid.Column="3" Height="28" IsEditable="True"/>
            <TextBlock Grid.Column="4" Text="Lavatório:" VerticalAlignment="Center" Margin="12,0,6,0"
                       ToolTip="Subida da aranha com joelho no pé"/>
            <ComboBox x:Name="combo_vanity" Grid.Column="5" Height="28" IsEditable="True"/>
        </Grid>

        <!-- PREVIA -->
        <Border Grid.Row="4" Background="#F5F5F5" CornerRadius="4" Padding="10">
            <StackPanel>
                <TextBlock Text="O que vai mudar:" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock x:Name="txt_preview" TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="btn_cancel" Content="Cancelar" Width="110" Height="35" Margin="0,0,10,0"/>
            <Button x:Name="btn_apply" Content="Aplicar" Width="110" Height="35"
                    Background="#1976D2" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
