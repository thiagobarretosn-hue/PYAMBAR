<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Slab Passes v6.0"
        Height="860" Width="1000" MinHeight="640" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABECALHO -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Passagens de Laje" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Escolha a laje: os tubos que a atravessam são detectados no projeto e nos vínculos marcados."
                       Foreground="#666" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- 1. LAJE E ORIGENS -->
        <Border Grid.Row="1" Background="#E3F2FD" BorderBrush="#2196F3" BorderThickness="1"
                CornerRadius="5" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Laje (nível):" FontWeight="Bold" VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <ComboBox x:Name="combo_level" Grid.Column="1" Height="30" FontSize="13"
                          ToolTip="A laje cujo topo está na cota deste nível (lida no vínculo estrutural)"/>
                <TextBlock x:Name="txt_slab" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Center"
                           Margin="14,0,0,0" Foreground="#0D47A1" FontSize="12"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Origens:" FontWeight="Bold"
                           VerticalAlignment="Top" Margin="0,10,8,0"/>
                <WrapPanel x:Name="panel_sources" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                           Margin="0,8,0,0"/>
            </Grid>
        </Border>

        <!-- 2. AGRUPAR POR -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Agrupar também por:" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="combo_filter" Grid.Column="1" Height="28"
                      ToolTip="Além do papel (Riser / Aranha) e do diâmetro"/>
        </Grid>

        <!-- GRUPOS -->
        <Border Grid.Row="3" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="diameter_panel" Margin="6"/>
            </ScrollViewer>
        </Border>

        <!-- 3. OPCOES -->
        <Border Grid.Row="4" Background="#F5F5F5" Padding="12" Margin="0,10,0,0" CornerRadius="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <CheckBox x:Name="chk_fit_slab" Content="Qtt e altura pela laje (fundo da pilha no fundo da laje)"
                              IsChecked="True" Margin="0,0,0,6"
                              ToolTip="Concrete Sleeve: Qtt = o menor que cobre a espessura. Outra família: topo na cota do nível"/>
                    <CheckBox x:Name="chk_inherit_params" Content="Herdar parâmetros de texto do tubo"
                              IsChecked="True" Margin="0,0,0,6"/>
                    <CheckBox x:Name="chk_floor" Content="Floor pelo nível da laje" IsChecked="True"
                              ToolTip="Ex.: 02 - LEVEL 2 = 2nd (gravado depois da herança: ganha do Floor do tubo)"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <CheckBox x:Name="chk_comments" Content="Comments (para que serve o passe)" IsChecked="True"
                              Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Riser +" VerticalAlignment="Center" Margin="20,0,6,0"/>
                        <ComboBox x:Name="combo_riser_source" Grid.Row="0" Grid.Column="1" Height="26"
                                  IsEditable="True"
                                  ToolTip="Parâmetro do tubo que completa 'Riser ...' — ou digite um texto livre"/>
                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="20,8,0,0">
                            <TextBlock Text="Subidas da aranha:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="P-Trap:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="combo_tub" Width="120" Height="26" IsEditable="True"
                                          ToolTip="Tub, Shower ou digite outro nome"/>
                                <TextBlock Text="Lavatório:" VerticalAlignment="Center" Margin="14,0,6,0"/>
                                <ComboBox x:Name="combo_vanity" Width="120" Height="26" IsEditable="True"
                                          ToolTip="Vanity, Laundry ou digite outro nome"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- STATUS -->
        <TextBlock x:Name="status_text" Grid.Row="5" Foreground="#555" FontSize="12"
                   Margin="0,8,0,0" TextWrapping="Wrap"/>

        <!-- BOTOES -->
        <Grid Grid.Row="6" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btn_sync" Grid.Column="0" Content="Ressincronizar passes deste nível…"
                    Height="35" Padding="14,0"
                    ToolTip="Passes já lançados na laje: recentralizar, bitola, família, Qtt, Comments e parâmetros"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="btn_cancel" Content="Cancelar" Width="110" Height="35" Margin="0,0,10,0"/>
                <Button x:Name="btn_apply" Content="Lançar passes" Width="140" Height="35"
                        Background="#1976D2" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
