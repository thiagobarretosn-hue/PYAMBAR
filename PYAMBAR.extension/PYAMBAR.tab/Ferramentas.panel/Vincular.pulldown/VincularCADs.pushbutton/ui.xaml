<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vincular CADs" Width="760" Height="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label x:Name="ScopeLabel" Grid.Row="0"
               FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>

        <DataGrid x:Name="CadGrid" Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Margin="0,0,0,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Arquivo"
                                    Binding="{Binding Arquivo}"
                                    Width="*" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="→ Vista de destino" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding Vistas}"
                                      SelectedItem="{Binding VistaAlvo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="Name"
                                      BorderThickness="0"
                                      Background="Transparent"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Posicionamento:" VerticalAlignment="Center"/>
            <ComboBox x:Name="PlacementBox" Grid.Row="0" Grid.Column="1" Margin="4,2,12,2"/>
            <Label Grid.Row="0" Grid.Column="2" Content="Unidade:" VerticalAlignment="Center"/>
            <ComboBox x:Name="UnitBox" Grid.Row="0" Grid.Column="3" Margin="4,2,0,2"/>

            <Label Grid.Row="1" Grid.Column="0" Content="Cores:" VerticalAlignment="Center"/>
            <ComboBox x:Name="ColorBox" Grid.Row="1" Grid.Column="1" Margin="4,2,12,2"/>
            <Label Grid.Row="1" Grid.Column="2" Content="Camadas:" VerticalAlignment="Center"/>
            <ComboBox x:Name="LayerBox" Grid.Row="1" Grid.Column="3" Margin="4,2,0,2"/>

            <CheckBox x:Name="ThisViewOnlyBox" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"
                      Content="Somente na vista de destino (Current view only)"
                      Margin="4,6,0,0"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancel" Content="Cancelar" Width="80"
                    Margin="0,0,8,0" Click="btn_cancel_click"/>
            <Button x:Name="BtnApply" Content="Vincular" Width="80"
                    IsDefault="True" Click="btn_apply_click"/>
        </StackPanel>
    </Grid>
</Window>
