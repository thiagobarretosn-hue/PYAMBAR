<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        Title="WBS → Unidade PRO"
        Height="420"
        Width="450"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="10">

        <!-- PARAM ORIGEM -->
        <TextBlock Text="Parâmetro Origem (WBS)" Margin="0,5"/>
        <ComboBox Name="cmb_source" Height="25"/>

        <!-- PARAM DESTINO -->
        <TextBlock Text="Parâmetro Destino" Margin="0,10,0,5"/>
        <ComboBox Name="cmb_target" Height="25"/>

        <!-- SUFIXO -->
        <TextBlock Text="Sufixo Inicial" Margin="0,10,0,5"/>
        <TextBox Name="txt_suffix" Text="01" Height="25"/>

        <!-- CHECK -->
        <CheckBox Name="chk_increment"
                  Content="Incrementar automaticamente"
                  Margin="0,10"/>

        <!-- BOTÕES -->
        <StackPanel Orientation="Horizontal" Margin="0,10">
            <Button Name="btn_preview"
                    Content="Preview"
                    Width="100"
                    Margin="5"/>

            <Button Name="btn_apply"
                    Content="Aplicar"
                    Width="100"
                    Margin="5"/>
        </StackPanel>

        <!-- GRID -->
        <DataGrid Name="grid_preview"
                  Margin="0,10"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  Height="180"/>

    </StackPanel>
</Window>
