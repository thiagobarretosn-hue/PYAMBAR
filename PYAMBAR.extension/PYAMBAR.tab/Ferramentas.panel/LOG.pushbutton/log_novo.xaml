<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novo apontamento"
        Height="480" Width="600" MinHeight="400" MinWidth="500"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#F4F6F9"
        FontFamily="Segoe UI" FontSize="12"
        Foreground="#1F2933"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#8A94A3"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Nota" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#5B6675"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9D1DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo" Property="BorderBrush" Value="#9DB6D6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E3E7ED" BorderThickness="1"
                CornerRadius="8" Padding="12,10">
            <StackPanel>
                <TextBlock Style="{StaticResource Rotulo}" Text="ONDE"/>
                <TextBlock x:Name="AlvosLabel" Style="{StaticResource Nota}"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="PickModeloBtn" Content="Selecionar elementos do modelo"
                            Click="ao_escolher_no_modelo" Margin="0,0,6,0"
                            ToolTip="A janela é ocultada: clique nos elementos deste modelo e tecle Enter (Esc cancela)"/>
                    <Button x:Name="PickVinculoBtn" Content="Selecionar elementos do vínculo"
                            Click="ao_escolher_no_vinculo" Margin="0"
                            ToolTip="O clique seleciona o elemento dentro do vínculo, sem usar Tab. Enter conclui, Esc cancela."/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Para:" VerticalAlignment="Center" Margin="2,0,8,0" Foreground="#5B6675"/>
            <ComboBox x:Name="ParaCombo" Width="240" Height="28" IsEditable="True"
                      VerticalContentAlignment="Center"
                      ToolTip="Em branco: toda a equipe. A lista inclui quem já participou dos apontamentos."/>
            <TextBlock Style="{StaticResource Nota}" VerticalAlignment="Center" Margin="10,0,0,0"
                       Text="Em branco: visível para toda a equipe."/>
        </StackPanel>

        <Border Grid.Row="2" Background="White" BorderBrush="#E3E7ED" BorderThickness="1"
                CornerRadius="8" Padding="12,10" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Rotulo}" Text="O QUE PRECISA SER FEITO"/>
                <TextBox x:Name="TextoBox" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Padding="4" BorderThickness="0"/>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="RecorteBtn" Content="Recorte de tela" Click="ao_recortar" Margin="0,0,6,0"
                    ToolTip="Abre o recorte do Windows (o mesmo Win+Shift+S). A imagem fica em DAT/LOG/img."/>
            <Button x:Name="TirarImagemBtn" Content="Sem imagem" Click="ao_tirar_imagem" Margin="0"/>
            <TextBlock x:Name="ImagemLabel" Style="{StaticResource Nota}" VerticalAlignment="Center"
                       Margin="12,0,0,0" Text="Sem imagem."/>
        </StackPanel>

        <TextBlock x:Name="ErroLabel" Grid.Row="4" Foreground="#C0392B" TextWrapping="Wrap"
                   Margin="2,8,0,0"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CancelarBtn" Content="Cancelar" Click="ao_cancelar"/>
            <Button x:Name="GravarBtn" Content="Gravar apontamento" Click="ao_gravar"
                    Background="#2969B0" BorderBrush="#2969B0" Foreground="White" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
