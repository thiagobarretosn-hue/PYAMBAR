<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verificar passes de laje"
        Height="560" Width="760" MinHeight="420" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#F4F6F9"
        FontFamily="Segoe UI" FontSize="12"
        Foreground="#1F2933"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#8A94A3"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Nota" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#5B6675"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Cartao" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E3E7ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9D1DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo" Property="BorderBrush" Value="#9DB6D6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Cartao}" Margin="0,0,5,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Rotulo}" Text="LAJES A VERIFICAR"/>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Nota}" Margin="0,0,0,6"
                           Text="Marcadas: as que já têm passe. A espessura é automática: dos passes da laje, senão dos pisos dos vínculos, senão a do modelo (padrão)."/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="LajesPanel"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Cartao}" Margin="5,0,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Rotulo}" Text="TUBOS DE"/>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Nota}" Margin="0,0,0,6"
                           Text="Entre parênteses: tubos verticais em cada modelo."/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="VinculosPanel"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Cartao}" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource Rotulo}" Text="TOLERÂNCIA DO EIXO"/>
                    <TextBox x:Name="ToleranciaBox"/>
                    <TextBlock Style="{StaticResource Nota}" Margin="0,4,8,0"
                               Text="Acima dela: atenção. Acima da folga física (tubo na parede do passe): erro."/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource Rotulo}" Text="RAIO DE BUSCA"/>
                    <TextBox x:Name="RaioBox"/>
                    <TextBlock Style="{StaticResource Nota}" Margin="0,4,8,0"
                               Text="Sem tubo livre nesse raio: 'passe sem tubo'."/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource Rotulo}" Text="REGRAS NO RELATÓRIO"/>
                    <StackPanel x:Name="RegrasPanel"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock x:Name="ErroLabel" Grid.Row="2" Grid.ColumnSpan="2" Foreground="#C0392B"
                   TextWrapping="Wrap" Margin="2,8,0,0"/>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CancelarBtn" Content="Cancelar" Click="ao_cancelar"/>
            <Button x:Name="VerificarBtn" Content="Verificar" Click="ao_verificar"
                    Background="#2969B0" BorderBrush="#2969B0" Foreground="White" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
