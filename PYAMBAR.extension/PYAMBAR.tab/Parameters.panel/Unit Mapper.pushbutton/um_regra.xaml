<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Regra de parâmetros"
        Height="580" Width="780" MinHeight="460" MinWidth="700"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#FFFFFFFF" TextElement.Foreground="#FF222222"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#FF222222"/>
        <SolidColorBrush x:Key="InkSoft" Color="#FF666666"/>
        <SolidColorBrush x:Key="Alt" Color="#FFF7F7F7"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Nome:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="NomeBox" Width="380" LostFocus="campo_mudou"/>
            <CheckBox x:Name="AtivaChk" Content="Ativa" Margin="14,0,0,0" IsChecked="True"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="QUANDO" FontWeight="Bold" VerticalAlignment="Center"/>
            <ComboBox x:Name="CombinarCombo" Width="190" Height="26" Margin="10,0,0,0"
                      SelectionChanged="campo_mudou"
                      ToolTip="E: o elemento precisa passar em todas as condições. OU: basta uma."/>
            <TextBlock Text="  (sem condição: vale para todo elemento)"
                       Foreground="{StaticResource InkSoft}" FontSize="11" VerticalAlignment="Center"/>
            <Button Content="+ condição" Margin="12,0,0,0" Click="btn_add_condicao"/>
        </StackPanel>
        <Border Grid.Row="2" BorderBrush="#FFE4E4E4" BorderThickness="1" Padding="6" Margin="0,0,0,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="CondPanel"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="ENTÃO" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="  cada linha grava um parâmetro"
                       Foreground="{StaticResource InkSoft}" FontSize="11" VerticalAlignment="Center"/>
            <Button Content="+ ação" Margin="12,0,0,0" Click="btn_add_acao"/>
        </StackPanel>
        <Border Grid.Row="4" BorderBrush="#FFE4E4E4" BorderThickness="1" Padding="6" Margin="0,0,0,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="AcaoPanel"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Gravar em:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="OndeCombo" Width="160" Height="26" SelectionChanged="campo_mudou"/>
            <CheckBox x:Name="SoVazioChk" Margin="16,0,0,0" Click="campo_mudou"
                      Content="Só se o parâmetro estiver vazio (não sobrescreve)"/>
        </StackPanel>

        <Border Grid.Row="6" Background="{StaticResource Alt}" Padding="8,6" Margin="0,0,0,10">
            <TextBlock x:Name="DescricaoLabel" TextWrapping="Wrap" FontSize="11"
                       Foreground="{StaticResource InkSoft}"/>
        </Border>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="90" Margin="0,0,8,0" Click="btn_cancelar"/>
            <Button Content="OK" Width="110" FontWeight="Bold" Click="btn_ok"/>
        </StackPanel>
    </Grid>
</Window>
