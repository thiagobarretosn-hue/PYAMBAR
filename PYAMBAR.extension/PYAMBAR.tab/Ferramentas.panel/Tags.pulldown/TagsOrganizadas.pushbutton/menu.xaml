<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tags"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="#F4F6F9"
        FontFamily="Segoe UI" FontSize="12"
        Foreground="#1F2933"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <!-- Menu curto de um template (Tag Installation Plans, Tag Wall FAC): so
         o TIPO de tag de cada elemento. O resto (arranjo, trama, margem) e o do
         template. As linhas sao montadas no menu_template.py (uma por
         categoria ativa no template). -->
    <Window.Resources>
        <SolidColorBrush x:Key="Texto2" Color="#5B6675"/>
        <SolidColorBrush x:Key="Borda" Color="#E3E7ED"/>
        <SolidColorBrush x:Key="BordaForte" Color="#C9D1DB"/>
        <SolidColorBrush x:Key="Acento" Color="#2969B0"/>
        <SolidColorBrush x:Key="AcentoEscuro" Color="#1F5A99"/>

        <Style x:Key="Botao" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordaForte}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo" Property="Background" Value="#EEF3FA"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Fundo" Property="BorderBrush" Value="{StaticResource Acento}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BotaoPrimario" TargetType="Button" BasedOn="{StaticResource Botao}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource Acento}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Acento}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo" Property="Background" Value="{StaticResource AcentoEscuro}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="18">
        <TextBlock x:Name="txt_titulo" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock x:Name="txt_vista" Margin="0,2,0,14" Foreground="{StaticResource Texto2}"
                   TextTrimming="CharacterEllipsis"/>

        <Border Background="White" BorderBrush="{StaticResource Borda}" BorderThickness="1"
                CornerRadius="8" Padding="14,10">
            <StackPanel>
                <TextBlock Text="TIPO DE TAG POR ELEMENTO" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{StaticResource Texto2}" Margin="0,0,0,8"/>
                <!-- linhas: rótulo + ComboBox, montadas no script.py -->
                <Grid x:Name="grd_tipos">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="155"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Seta (todas as tags)" VerticalAlignment="Center" Margin="15,0,8,0"/>
            <ComboBox x:Name="cmb_seta" Grid.Column="1" MinHeight="28" Margin="0,0,15,0"/>
        </Grid>

        <!-- ajuste fino da tag de tubo alinhada (so nos templates que a usam):
             mm de papel. A altura do texto na tag e da FAMILIA — mudou a
             familia, corrige aqui (Thiago, 26/10/2026) -->
        <Border x:Name="pnl_ajuste" Visibility="Collapsed" Margin="0,12,0,0" Background="White"
                BorderBrush="{StaticResource Borda}" BorderThickness="1" CornerRadius="8" Padding="14,10">
            <StackPanel>
                <TextBlock Text="AJUSTE FINO DA TAG DE TUBO (MM NO PAPEL)" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{StaticResource Texto2}" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Tubo horizontal — texto ACIMA do tubo" VerticalAlignment="Center" Margin="0,3,8,3"/>
                    <TextBox x:Name="txt_acima" Grid.Column="1" MinHeight="26" VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Right" Margin="0,3,0,3"/>
                    <TextBlock Grid.Row="1" Text="Tubo horizontal — texto ABAIXO do tubo" VerticalAlignment="Center"
                               Margin="0,3,8,3"/>
                    <TextBox x:Name="txt_abaixo" Grid.Row="1" Grid.Column="1" MinHeight="26"
                             VerticalContentAlignment="Center" HorizontalContentAlignment="Right" Margin="0,3,0,3"/>
                    <TextBlock Grid.Row="2" Text="Tubo vertical — texto à ESQUERDA do tubo" VerticalAlignment="Center"
                               Margin="0,3,8,3"/>
                    <TextBox x:Name="txt_esquerda" Grid.Row="2" Grid.Column="1" MinHeight="26"
                             VerticalContentAlignment="Center" HorizontalContentAlignment="Right" Margin="0,3,0,3"/>
                    <TextBlock Grid.Row="3" Text="Tubo vertical — texto à DIREITA do tubo" VerticalAlignment="Center"
                               Margin="0,3,8,3"/>
                    <TextBox x:Name="txt_direita" Grid.Row="3" Grid.Column="1" MinHeight="26"
                             VerticalContentAlignment="Center" HorizontalContentAlignment="Right" Margin="0,3,0,3"/>
                </Grid>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Texto2}"
                           Text="Distância do eixo do tubo ao centro do texto. Um lado ficou longe? Diminua só aquele lado."/>
            </StackPanel>
        </Border>

        <CheckBox x:Name="chk_refazer" Margin="2,14,0,0" IsChecked="True" VerticalContentAlignment="Center">
            <TextBlock x:Name="txt_refazer" TextWrapping="Wrap"
                       Text="Apagar e refazer as tags que o botão coloca"/>
        </CheckBox>

        <DockPanel Margin="0,18,0,0" LastChildFill="False">
            <Button x:Name="btn_executar" DockPanel.Dock="Right" Content="Executar" Margin="8,0,0,0"
                    Style="{StaticResource BotaoPrimario}" IsDefault="True" Click="executar_click"/>
            <Button x:Name="btn_cancelar" DockPanel.Dock="Right" Content="Cancelar"
                    Style="{StaticResource Botao}" IsCancel="True" Click="cancelar_click"/>
        </DockPanel>
    </StackPanel>
</Window>
